<Page x:Class="RadioButtonDemo.Pages.GroupingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RadioButtonDemo.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="分组管理">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="RadioButton 分组管理" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="20" Margin="0,0,0,20" Background="#F9F9F9">
                <StackPanel>
                    <TextBlock Text="使用GroupName属性分组" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="通过GroupName属性可以将RadioButton分为不同的组，同一组内只能有一个选中:" 
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    
                    <Grid Margin="20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Group1组:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <RadioButton GroupName="Group1" Content="选项1" Margin="5"/>
                            <RadioButton GroupName="Group1" Content="选项2" Margin="5"/>
                            <RadioButton GroupName="Group1" Content="选项3" Margin="5"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Group2组:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <RadioButton GroupName="Group2" Content="选择A" Margin="5"/>
                            <RadioButton GroupName="Group2" Content="选择B" Margin="5"/>
                            <RadioButton GroupName="Group2" Content="选择C" Margin="5"/>
                        </StackPanel>
                    </Grid>
                    
                    <TextBlock Text="XAML代码:" FontWeight="Bold" Margin="0,20,0,5"/>
                    <Border Background="#333333" Padding="10" Margin="0,0,0,10">
                        <TextBlock Foreground="White" FontFamily="Consolas" TextWrapping="Wrap">
                            <![CDATA[<StackPanel>
    <!-- 第一组 -->
    <RadioButton GroupName="Group1" Content="选项1" Margin="5"/>
    <RadioButton GroupName="Group1" Content="选项2" Margin="5"/>
    <RadioButton GroupName="Group1" Content="选项3" Margin="5"/>
    
    <!-- 第二组 -->
    <RadioButton GroupName="Group2" Content="选择A" Margin="5"/>
    <RadioButton GroupName="Group2" Content="选择B" Margin="5"/>
    <RadioButton GroupName="Group2" Content="选择C" Margin="5"/>
</StackPanel>]]>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>
            
            <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="20" Margin="0,0,0,20" Background="#F9F9F9">
                <StackPanel>
                    <TextBlock Text="通过布局元素自动分组" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="如果不设置GroupName，RadionButton将根据父容器自动分组:" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    
                    <Grid Margin="20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Margin="0,0,20,0" BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Background="#EEEEEE">
                            <StackPanel>
                                <TextBlock Text="StackPanel 1:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <RadioButton Content="选项1" Margin="5"/>
                                <RadioButton Content="选项2" Margin="5"/>
                                <RadioButton Content="选项3" Margin="5"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Background="#EEEEEE">
                            <StackPanel>
                                <TextBlock Text="StackPanel 2:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <RadioButton Content="选项A" Margin="5"/>
                                <RadioButton Content="选项B" Margin="5"/>
                                <RadioButton Content="选项C" Margin="5"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    
                    <TextBlock Text="说明:" FontWeight="Bold" Margin="0,20,0,5"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        当未指定GroupName时，RadioButton将自动与同一逻辑父元素中的其他RadioButton形成一个分组。
                        在这个例子中，两个StackPanel中的RadioButton分别形成了两个不同的组。
                    </TextBlock>
                </StackPanel>
            </Border>
            
            <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="20" Margin="0,0,0,20" Background="#F9F9F9">
                <StackPanel>
                    <TextBlock Text="组状态查看" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="您可以在下面测试RadioButton组的行为:" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    
                    <StackPanel Margin="20,10">
                        <GroupBox Header="测试组 (GroupName='TestGroup')">
                            <StackPanel Margin="10">
                                <RadioButton x:Name="rbTest1" GroupName="TestGroup" Content="选项1" Margin="5" Checked="TestGroup_Checked"/>
                                <RadioButton x:Name="rbTest2" GroupName="TestGroup" Content="选项2" Margin="5" Checked="TestGroup_Checked"/>
                                <RadioButton x:Name="rbTest3" GroupName="TestGroup" Content="选项3" Margin="5" Checked="TestGroup_Checked"/>
                                
                                <TextBlock Text="当前选中项:" FontWeight="SemiBold" Margin="5,20,0,5"/>
                                <TextBlock x:Name="txtCurrentSelected" Text="无" Margin="5,0,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page> 