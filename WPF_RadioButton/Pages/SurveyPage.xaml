<Page x:Class="RadioButtonDemo.Pages.SurveyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RadioButtonDemo.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="问卷调查示例">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="RadioButton 问卷调查示例" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="20" Margin="0,0,0,20" Background="#F9F9F9">
                <StackPanel>
                    <TextBlock Text="简单问卷调查" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="RadioButton在问卷调查表单中的应用示例:" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    
                    <StackPanel x:Name="surveyForm" Margin="20,10">
                        <!-- 问题1 -->
                        <TextBlock Text="1. 您的年龄范围?" FontWeight="Bold" Margin="0,20,0,10"/>
                        <RadioButton x:Name="rbAge1" Content="18岁以下" GroupName="Age" Margin="5" Checked="Survey_ValueChanged"/>
                        <RadioButton x:Name="rbAge2" Content="18-25岁" GroupName="Age" Margin="5" Checked="Survey_ValueChanged"/>
                        <RadioButton x:Name="rbAge3" Content="26-35岁" GroupName="Age" Margin="5" Checked="Survey_ValueChanged"/>
                        <RadioButton x:Name="rbAge4" Content="36-50岁" GroupName="Age" Margin="5" Checked="Survey_ValueChanged"/>
                        <RadioButton x:Name="rbAge5" Content="50岁以上" GroupName="Age" Margin="5" Checked="Survey_ValueChanged"/>
                        
                        <!-- 问题2 -->
                        <TextBlock Text="2. 您最喜欢哪种编程语言?" FontWeight="Bold" Margin="0,20,0,10"/>
                        <RadioButton x:Name="rbLang1" Content="C#" GroupName="ProgrammingLanguage" Margin="5" Checked="Survey_ValueChanged"/>
                        <RadioButton x:Name="rbLang2" Content="Java" GroupName="ProgrammingLanguage" Margin="5" Checked="Survey_ValueChanged"/>
                        <RadioButton x:Name="rbLang3" Content="Python" GroupName="ProgrammingLanguage" Margin="5" Checked="Survey_ValueChanged"/>
                        <RadioButton x:Name="rbLang4" Content="C++" GroupName="ProgrammingLanguage" Margin="5" Checked="Survey_ValueChanged"/>
                        <RadioButton x:Name="rbLang5" Content="JavaScript" GroupName="ProgrammingLanguage" Margin="5" Checked="Survey_ValueChanged"/>
                        <RadioButton x:Name="rbLangOther" Content="其他" GroupName="ProgrammingLanguage" Margin="5" Checked="Survey_ValueChanged"/>
                        
                        <!-- 条件显示文本框 - 修改为使用标准属性 -->
                        <TextBox x:Name="txtOtherLanguage" Margin="25,5,5,5" 
                                Width="300" HorizontalAlignment="Left"
                                Visibility="Collapsed"
                                TextChanged="OtherLanguage_TextChanged"/>
                        <TextBlock x:Name="txtPlaceholder" Text="请指定其他语言" Margin="25,0,0,0" Foreground="Gray" 
                                  Visibility="Collapsed"
                                  IsHitTestVisible="False"/>
                        
                        <!-- 问题3 -->
                        <TextBlock Text="3. 您使用WPF的频率?" FontWeight="Bold" Margin="0,20,0,10"/>
                        <RadioButton x:Name="rbFreq1" Content="每天都用" GroupName="Frequency" Margin="5" Checked="Survey_ValueChanged"/>
                        <RadioButton x:Name="rbFreq2" Content="每周几次" GroupName="Frequency" Margin="5" Checked="Survey_ValueChanged"/>
                        <RadioButton x:Name="rbFreq3" Content="每月几次" GroupName="Frequency" Margin="5" Checked="Survey_ValueChanged"/>
                        <RadioButton x:Name="rbFreq4" Content="很少使用" GroupName="Frequency" Margin="5" Checked="Survey_ValueChanged"/>
                        <RadioButton x:Name="rbFreq5" Content="从未使用过" GroupName="Frequency" Margin="5" Checked="Survey_ValueChanged"/>
                        
                        <!-- 提交按钮 -->
                        <Button x:Name="btnSubmit" Content="提交" Width="100" 
                               HorizontalAlignment="Left" Margin="0,30,0,10" Padding="10,5"
                               Click="SubmitSurvey_Click" IsEnabled="False"/>
                    </StackPanel>
                    
                    <!-- 结果面板 -->
                    <Border x:Name="resultPanel" BorderBrush="#CCCCCC" BorderThickness="1" 
                           Margin="20,20,20,10" Padding="15" Background="#EEEEEE"
                           Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="问卷提交成功!" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                            <TextBlock Text="您的回答:" FontWeight="SemiBold" Margin="0,10,0,5"/>
                            <TextBlock x:Name="txtResult" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            
            <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="20" Margin="0,0,0,20" Background="#F9F9F9">
                <StackPanel>
                    <TextBlock Text="实现要点" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                        1. 使用GroupName属性将RadioButton按问题分组
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                        2. 使用事件监听所有选项的变化
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                        3. 条件显示其他输入框(当选择"其他"选项时)
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                        4. 验证所有问题是否已回答，以启用提交按钮
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                        5. 收集并显示回答结果
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page> 