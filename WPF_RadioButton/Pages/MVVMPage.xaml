<Page x:Class="RadioButtonDemo.Pages.MVVMPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RadioButtonDemo.Pages"
      xmlns:converters="clr-namespace:RadioButtonDemo.Converters"
      xmlns:models="clr-namespace:RadioButtonDemo.Models"
      xmlns:viewmodels="clr-namespace:RadioButtonDemo.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MVVM模式">

    <Page.Resources>
        <converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <viewmodels:SettingsViewModel x:Key="SettingsViewModel"/>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="20" DataContext="{StaticResource SettingsViewModel}">
            <TextBlock Text="RadioButton 与 MVVM模式" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="20" Margin="0,0,0,20" Background="#F9F9F9">
                <StackPanel>
                    <TextBlock Text="主题设置示例" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="使用MVVM模式实现的主题设置页面，使用RadioButton进行选择:" 
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    
                    <Grid Margin="20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <GroupBox Header="主题设置">
                                <StackPanel Margin="10">
                                    <RadioButton Content="浅色主题" Margin="5"
                                         IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:ThemeOption.Light}}"
                                         Command="{Binding ThemeChangeCommand}"
                                         CommandParameter="{x:Static models:ThemeOption.Light}"/>
                                    
                                    <RadioButton Content="深色主题" Margin="5"
                                         IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:ThemeOption.Dark}}"
                                         Command="{Binding ThemeChangeCommand}"
                                         CommandParameter="{x:Static models:ThemeOption.Dark}"/>
                                    
                                    <RadioButton Content="跟随系统" Margin="5"
                                         IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:ThemeOption.System}}"
                                         Command="{Binding ThemeChangeCommand}"
                                         CommandParameter="{x:Static models:ThemeOption.System}"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="MVVM模式特点:" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                                • 使用命令(Command)代替事件处理程序
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                                • ViewModel包含所有业务逻辑
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                                • View仅负责显示，与ViewModel通过数据绑定通信
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                                • 这种模式便于单元测试和代码重用
                            </TextBlock>
                            
                            <Border Background="#EEEEEE" Padding="10" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="当前主题设置:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding SelectedTheme}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    
                    <TextBlock Text="XAML代码:" FontWeight="Bold" Margin="0,20,0,5"/>
                    <Border Background="#333333" Padding="10" Margin="0,0,0,10">
                        <TextBlock Foreground="White" FontFamily="Consolas" TextWrapping="Wrap">
                            <![CDATA[<RadioButton Content="浅色主题" 
             IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumToBoolConverter}, 
                          ConverterParameter={x:Static local:ThemeOption.Light}}"
             Command="{Binding ThemeChangeCommand}"
             CommandParameter="{x:Static local:ThemeOption.Light}"/>]]>
                        </TextBlock>
                    </Border>
                    
                    <TextBlock Text="ViewModel代码:" FontWeight="Bold" Margin="0,10,0,5"/>
                    <Border Background="#333333" Padding="10" Margin="0,0,0,10">
                        <TextBlock Foreground="White" FontFamily="Consolas" TextWrapping="Wrap">
                            <![CDATA[public class SettingsViewModel : ViewModelBase
{
    private ThemeOption _selectedTheme;
    
    public ThemeOption SelectedTheme
    {
        get => _selectedTheme;
        set 
        { 
            if (_selectedTheme != value)
            {
                _selectedTheme = value;
                OnPropertyChanged(nameof(SelectedTheme));
                ApplyThemeChange(value);
            }
        }
    }
    
    public ICommand ThemeChangeCommand { get; }
    
    public SettingsViewModel()
    {
        // 默认选择浅色主题
        _selectedTheme = ThemeOption.Light;
        
        // 初始化命令
        ThemeChangeCommand = new RelayCommand(ChangeTheme);
    }
    
    private void ChangeTheme(object parameter)
    {
        if (parameter is ThemeOption theme)
        {
            SelectedTheme = theme;
        }
    }
}]]>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>
            
            <TextBlock Text="MVVM模式的优势" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,10"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,20,5">
                1. 分离关注点: 视图(View)和业务逻辑(ViewModel)完全分离
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="20,0,20,5">
                2. 可测试性: 可以单独对ViewModel进行单元测试，不需要UI
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="20,0,20,5">
                3. 设计时数据: 可以为设计器提供样本数据，便于UI设计
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="20,0,20,5">
                4. 灵活性: 可以轻松更换视图而不影响业务逻辑
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="20,0,20,5">
                5. 适合复杂应用: 对于复杂的WPF应用，MVVM模式可以提供更好的代码组织和维护性
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</Page> 