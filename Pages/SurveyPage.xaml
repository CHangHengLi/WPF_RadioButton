<Page
    x:Class="RadioButtonDemo.Pages.SurveyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:RadioButtonDemo.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="问卷调查示例"
    d:DesignHeight="1000"
    d:DesignWidth="800"
    Background="AntiqueWhite"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock
                Margin="0,0,0,20"
                FontSize="24"
                FontWeight="Bold"
                Text="RadioButton 问卷调查示例" />

            <Border
                Margin="0,0,0,20"
                Padding="20"
                Background="#F9F9F9"
                BorderBrush="#DDDDDD"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="简单问卷调查" />
                    <TextBlock
                        Margin="0,0,0,10"
                        Text="RadioButton在问卷调查表单中的应用示例:"
                        TextWrapping="Wrap" />

                    <StackPanel x:Name="surveyForm" Margin="20,10">
                        <!--  问题1  -->
                        <TextBlock
                            Margin="0,20,0,10"
                            FontWeight="Bold"
                            Text="1. 您的年龄范围?" />
                        <RadioButton
                            x:Name="rbAge1"
                            Margin="5"
                            Checked="Survey_ValueChanged"
                            Content="18岁以下"
                            GroupName="Age" />
                        <RadioButton
                            x:Name="rbAge2"
                            Margin="5"
                            Checked="Survey_ValueChanged"
                            Content="18-25岁"
                            GroupName="Age" />
                        <RadioButton
                            x:Name="rbAge3"
                            Margin="5"
                            Checked="Survey_ValueChanged"
                            Content="26-35岁"
                            GroupName="Age" />
                        <RadioButton
                            x:Name="rbAge4"
                            Margin="5"
                            Checked="Survey_ValueChanged"
                            Content="36-50岁"
                            GroupName="Age" />
                        <RadioButton
                            x:Name="rbAge5"
                            Margin="5"
                            Checked="Survey_ValueChanged"
                            Content="50岁以上"
                            GroupName="Age" />

                        <!--  问题2  -->
                        <TextBlock
                            Margin="0,20,0,10"
                            FontWeight="Bold"
                            Text="2. 您最喜欢哪种编程语言?" />
                        <RadioButton
                            x:Name="rbLang1"
                            Margin="5"
                            Checked="Survey_ValueChanged"
                            Content="C#"
                            GroupName="ProgrammingLanguage" />
                        <RadioButton
                            x:Name="rbLang2"
                            Margin="5"
                            Checked="Survey_ValueChanged"
                            Content="Java"
                            GroupName="ProgrammingLanguage" />
                        <RadioButton
                            x:Name="rbLang3"
                            Margin="5"
                            Checked="Survey_ValueChanged"
                            Content="Python"
                            GroupName="ProgrammingLanguage" />
                        <RadioButton
                            x:Name="rbLang4"
                            Margin="5"
                            Checked="Survey_ValueChanged"
                            Content="C++"
                            GroupName="ProgrammingLanguage" />
                        <RadioButton
                            x:Name="rbLang5"
                            Margin="5"
                            Checked="Survey_ValueChanged"
                            Content="JavaScript"
                            GroupName="ProgrammingLanguage" />
                        <RadioButton
                            x:Name="rbLangOther"
                            Margin="5"
                            Checked="Survey_ValueChanged"
                            Content="其他"
                            GroupName="ProgrammingLanguage" />

                        <!--  条件显示文本框 - 修改为使用标准属性  -->
                        <TextBox
                            x:Name="txtOtherLanguage"
                            Width="300"
                            Margin="25,5,5,5"
                            HorizontalAlignment="Left"
                            TextChanged="OtherLanguage_TextChanged"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="txtPlaceholder"
                            Margin="25,0,0,0"
                            Foreground="Gray"
                            IsHitTestVisible="False"
                            Text="请指定其他语言"
                            Visibility="Collapsed" />

                        <!--  问题3  -->
                        <TextBlock
                            Margin="0,20,0,10"
                            FontWeight="Bold"
                            Text="3. 您使用WPF的频率?" />
                        <RadioButton
                            x:Name="rbFreq1"
                            Margin="5"
                            Checked="Survey_ValueChanged"
                            Content="每天都用"
                            GroupName="Frequency" />
                        <RadioButton
                            x:Name="rbFreq2"
                            Margin="5"
                            Checked="Survey_ValueChanged"
                            Content="每周几次"
                            GroupName="Frequency" />
                        <RadioButton
                            x:Name="rbFreq3"
                            Margin="5"
                            Checked="Survey_ValueChanged"
                            Content="每月几次"
                            GroupName="Frequency" />
                        <RadioButton
                            x:Name="rbFreq4"
                            Margin="5"
                            Checked="Survey_ValueChanged"
                            Content="很少使用"
                            GroupName="Frequency" />
                        <RadioButton
                            x:Name="rbFreq5"
                            Margin="5"
                            Checked="Survey_ValueChanged"
                            Content="从未使用过"
                            GroupName="Frequency" />

                        <!--  提交按钮  -->
                        <Button
                            x:Name="btnSubmit"
                            Width="100"
                            Margin="0,30,0,10"
                            Padding="10,5"
                            HorizontalAlignment="Left"
                            Click="SubmitSurvey_Click"
                            Content="提交"
                            IsEnabled="False" />
                    </StackPanel>

                    <!--  结果面板  -->
                    <Border
                        x:Name="resultPanel"
                        Margin="20,20,20,10"
                        Padding="15"
                        Background="#EEEEEE"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="16"
                                FontWeight="Bold"
                                Text="问卷提交成功!" />
                            <TextBlock
                                Margin="0,10,0,5"
                                FontWeight="SemiBold"
                                Text="您的回答:" />
                            <TextBlock x:Name="txtResult" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,20"
                Padding="20"
                Background="#F9F9F9"
                BorderBrush="#DDDDDD"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="实现要点" />
                    <TextBlock Margin="0,0,0,5" TextWrapping="Wrap">
                        1. 使用GroupName属性将RadioButton按问题分组
                    </TextBlock>
                    <TextBlock Margin="0,0,0,5" TextWrapping="Wrap">
                        2. 使用事件监听所有选项的变化
                    </TextBlock>
                    <TextBlock Margin="0,0,0,5" TextWrapping="Wrap">
                        3. 条件显示其他输入框(当选择"其他"选项时)
                    </TextBlock>
                    <TextBlock Margin="0,0,0,5" TextWrapping="Wrap">
                        4. 验证所有问题是否已回答，以启用提交按钮
                    </TextBlock>
                    <TextBlock Margin="0,0,0,5" TextWrapping="Wrap">
                        5. 收集并显示回答结果
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page> 