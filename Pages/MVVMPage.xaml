<Page
    x:Class="RadioButtonDemo.Pages.MVVMPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:RadioButtonDemo.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:RadioButtonDemo.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:RadioButtonDemo.Models"
    xmlns:viewmodels="clr-namespace:RadioButtonDemo.ViewModels"
    Title="MVVM模式"
    d:DesignHeight="850"
    d:DesignWidth="800"
    Background="{DynamicResource BackgroundBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
        <viewmodels:SettingsViewModel x:Key="SettingsViewModel" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="20" DataContext="{StaticResource SettingsViewModel}">
            <TextBlock
                Margin="0,0,0,20"
                FontSize="24"
                FontWeight="Bold"
                Foreground="{DynamicResource ForegroundBrush}"
                Text="RadioButton 与 MVVM模式" />

            <Border
                Margin="0,0,0,20"
                Padding="20"
                Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="主题设置示例" />
                    <TextBlock
                        Margin="0,0,0,10"
                        Text="使用MVVM模式实现的主题设置页面，使用RadioButton进行选择:"
                        TextWrapping="Wrap" />

                    <Grid Margin="20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <GroupBox Header="主题设置">
                                <StackPanel Margin="10">
                                    <RadioButton
                                        Margin="5"
                                        Command="{Binding ThemeChangeCommand}"
                                        CommandParameter="{x:Static models:ThemeOption.Light}"
                                        Content="浅色主题"
                                        IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:ThemeOption.Light}}" />

                                    <RadioButton
                                        Margin="5"
                                        Command="{Binding ThemeChangeCommand}"
                                        CommandParameter="{x:Static models:ThemeOption.Dark}"
                                        Content="深色主题"
                                        IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:ThemeOption.Dark}}" />

                                    <RadioButton
                                        Margin="5"
                                        Command="{Binding ThemeChangeCommand}"
                                        CommandParameter="{x:Static models:ThemeOption.System}"
                                        Content="跟随系统"
                                        IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:ThemeOption.System}}" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock
                                Margin="0,0,0,10"
                                FontWeight="SemiBold"
                                Text="MVVM模式特点:" />
                            <TextBlock Margin="0,0,0,5" TextWrapping="Wrap">
                                • 使用命令(Command)代替事件处理程序
                            </TextBlock>
                            <TextBlock Margin="0,0,0,5" TextWrapping="Wrap">
                                • ViewModel包含所有业务逻辑
                            </TextBlock>
                            <TextBlock Margin="0,0,0,5" TextWrapping="Wrap">
                                • View仅负责显示，与ViewModel通过数据绑定通信
                            </TextBlock>
                            <TextBlock Margin="0,0,0,5" TextWrapping="Wrap">
                                • 这种模式便于单元测试和代码重用
                            </TextBlock>

                            <Border
                                Margin="0,20,0,0"
                                Padding="10"
                                Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,5"
                                        FontWeight="SemiBold"
                                        Text="当前主题设置:" />
                                    <TextBlock Text="{Binding SelectedTheme}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Margin="0,20,0,5"
                        FontWeight="Bold"
                        Text="XAML代码:" />
                    <Border
                        Margin="0,0,0,10"
                        Padding="10"
                        Background="#333333">
                        <TextBlock
                            FontFamily="Consolas"
                            Foreground="White"
                            TextWrapping="Wrap">
                            <![CDATA[<RadioButton Content="浅色主题" 
             IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumToBoolConverter}, 
                          ConverterParameter={x:Static local:ThemeOption.Light}}"
             Command="{Binding ThemeChangeCommand}"
             CommandParameter="{x:Static local:ThemeOption.Light}"/>]]>
                        </TextBlock>
                    </Border>

                    <TextBlock
                        Margin="0,10,0,5"
                        FontWeight="Bold"
                        Text="ViewModel代码:" />
                    <Border
                        Margin="0,0,0,10"
                        Padding="10"
                        Background="#333333">
                        <TextBlock
                            FontFamily="Consolas"
                            Foreground="White"
                            TextWrapping="Wrap">
                            <![CDATA[public class SettingsViewModel : ViewModelBase
{
    private ThemeOption _selectedTheme;
    
    public ThemeOption SelectedTheme
    {
        get => _selectedTheme;
        set 
        { 
            if (_selectedTheme != value)
            {
                _selectedTheme = value;
                OnPropertyChanged(nameof(SelectedTheme));
                ApplyThemeChange(value);
            }
        }
    }
    
    public ICommand ThemeChangeCommand { get; }
    
    public SettingsViewModel()
    {
        // 默认选择浅色主题
        _selectedTheme = ThemeOption.Light;
        
        // 初始化命令
        ThemeChangeCommand = new RelayCommand(ChangeTheme);
    }
    
    private void ChangeTheme(object parameter)
    {
        if (parameter is ThemeOption theme)
        {
            SelectedTheme = theme;
        }
    }
}]]>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock
                Margin="0,10,0,10"
                FontSize="18"
                FontWeight="SemiBold"
                Text="MVVM模式的优势" />
            <TextBlock Margin="20,0,20,5" TextWrapping="Wrap">
                1. 分离关注点: 视图(View)和业务逻辑(ViewModel)完全分离
            </TextBlock>
            <TextBlock Margin="20,0,20,5" TextWrapping="Wrap">
                2. 可测试性: 可以单独对ViewModel进行单元测试，不需要UI
            </TextBlock>
            <TextBlock Margin="20,0,20,5" TextWrapping="Wrap">
                3. 设计时数据: 可以为设计器提供样本数据，便于UI设计
            </TextBlock>
            <TextBlock Margin="20,0,20,5" TextWrapping="Wrap">
                4. 灵活性: 可以轻松更换视图而不影响业务逻辑
            </TextBlock>
            <TextBlock Margin="20,0,20,5" TextWrapping="Wrap">
                5. 适合复杂应用: 对于复杂的WPF应用，MVVM模式可以提供更好的代码组织和维护性
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</Page> 