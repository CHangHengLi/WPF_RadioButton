<Page
    x:Class="RadioButtonDemo.Pages.TabsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:RadioButtonDemo.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="选项卡示例"
    d:DesignHeight="600"
    d:DesignWidth="800"
    Background="AntiqueWhite"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  定义选项卡样式  -->
        <Style x:Key="TabRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2">
                            <ContentPresenter
                                x:Name="contentPresenter"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC" />
                                <Setter Property="Foreground" Value="#007ACC" />
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EEEEEE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  定义内容  -->
        <StackPanel x:Key="HomeContent">
            <TextBlock
                Margin="10"
                FontSize="24"
                FontWeight="SemiBold"
                Text="首页内容" />
            <TextBlock
                Margin="10,0"
                Text="这里可以包含首页的介绍信息和概览。"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel x:Key="SettingsContent">
            <TextBlock
                Margin="10"
                FontSize="24"
                FontWeight="SemiBold"
                Text="设置页面" />
            <CheckBox Margin="10,5" Content="启用功能A" />
            <CheckBox Margin="10,5" Content="启用功能B" />
            <CheckBox Margin="10,5" Content="启用功能C" />
        </StackPanel>

        <StackPanel x:Key="HelpContent">
            <TextBlock
                Margin="10"
                FontSize="24"
                FontWeight="SemiBold"
                Text="帮助中心" />
            <TextBlock Margin="10,0" TextWrapping="Wrap">
                这里提供程序的使用帮助和指南。如果您遇到任何问题，请参考以下内容或联系支持团队。
            </TextBlock>
        </StackPanel>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock
                Margin="0,0,0,20"
                FontSize="24"
                FontWeight="Bold"
                Text="RadioButton 用作选项卡" />

            <Border
                Margin="0,0,0,20"
                Padding="20"
                Background="#F9F9F9"
                BorderBrush="#DDDDDD"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="选项卡式界面实现" />
                    <TextBlock
                        Margin="0,0,0,10"
                        Text="使用RadioButton实现类似TabControl的选项卡式界面:"
                        TextWrapping="Wrap" />

                    <Grid Margin="20,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  选项卡区域  -->
                        <Border
                            Grid.Row="0"
                            Background="#F0F0F0"
                            BorderBrush="#DDDDDD"
                            BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton
                                    x:Name="tabHome"
                                    Content="首页"
                                    GroupName="Tabs"
                                    IsChecked="True"
                                    Style="{StaticResource TabRadioButtonStyle}" />
                                <RadioButton
                                    x:Name="tabSettings"
                                    Content="设置"
                                    GroupName="Tabs"
                                    Style="{StaticResource TabRadioButtonStyle}" />
                                <RadioButton
                                    x:Name="tabHelp"
                                    Content="帮助"
                                    GroupName="Tabs"
                                    Style="{StaticResource TabRadioButtonStyle}" />
                            </StackPanel>
                        </Border>

                        <!--  内容区域  -->
                        <Border
                            Grid.Row="1"
                            MinHeight="200"
                            Background="White">
                            <ContentControl Margin="10">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=tabHome}" Value="True">
                                                <Setter Property="Content" Value="{StaticResource HomeContent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=tabSettings}" Value="True">
                                                <Setter Property="Content" Value="{StaticResource SettingsContent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=tabHelp}" Value="True">
                                                <Setter Property="Content" Value="{StaticResource HelpContent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </Border>
                    </Grid>

                    <TextBlock
                        Margin="0,20,0,5"
                        FontWeight="Bold"
                        Text="实现说明:" />
                    <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                        这个例子展示了如何使用RadioButton实现选项卡式界面。通过自定义RadioButton的样式和模板，使其呈现出类似标签页的外观。
                        内容区域使用ContentControl配合数据触发器(DataTrigger)根据选中的RadioButton动态切换显示内容。
                        这种方法比使用TabControl更灵活，可以实现更多自定义样式。
                    </TextBlock>

                    <Expander Margin="0,10" Header="查看相关代码">
                        <StackPanel>
                            <TextBlock
                                Margin="0,10,0,5"
                                FontWeight="Bold"
                                Text="XAML代码:" />
                            <Border
                                Margin="0,0,0,10"
                                Padding="10"
                                Background="#333333">
                                <TextBlock
                                    FontFamily="Consolas"
                                    Foreground="White"
                                    TextWrapping="Wrap">
                                    <![CDATA[<!-- 选项卡区域 -->
<Border Grid.Row="0" Background="#F0F0F0">
    <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="tabHome" Content="首页" GroupName="Tabs" IsChecked="True" 
                   Style="{StaticResource TabRadioButtonStyle}"/>
        <RadioButton x:Name="tabSettings" Content="设置" GroupName="Tabs" 
                   Style="{StaticResource TabRadioButtonStyle}"/>
        <RadioButton x:Name="tabHelp" Content="帮助" GroupName="Tabs" 
                   Style="{StaticResource TabRadioButtonStyle}"/>
    </StackPanel>
</Border>

<!-- 内容区域 -->
<ContentControl>
    <ContentControl.Style>
        <Style TargetType="ContentControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=tabHome}" Value="True">
                    <Setter Property="Content" Value="{StaticResource HomeContent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChecked, ElementName=tabSettings}" Value="True">
                    <Setter Property="Content" Value="{StaticResource SettingsContent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChecked, ElementName=tabHelp}" Value="True">
                    <Setter Property="Content" Value="{StaticResource HelpContent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentControl.Style>
</ContentControl>]]>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page> 