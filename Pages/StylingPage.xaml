<Page
    x:Class="RadioButtonDemo.Pages.StylingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:RadioButtonDemo.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="样式与模板"
    d:DesignHeight="1150"
    d:DesignWidth="800"
    Background="AntiqueWhite"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  基本样式  -->
        <Style x:Key="CustomRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="Navy" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="5" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="Red" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="Green" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  自定义模板  -->
        <ControlTemplate x:Key="CustomRadioButtonTemplate" TargetType="RadioButton">
            <Border
                x:Name="border"
                Padding="5"
                Background="LightGray"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  自定义单选按钮外观  -->
                    <Grid
                        Width="16"
                        Height="16"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center">
                        <Ellipse
                            x:Name="outerEllipse"
                            Fill="White"
                            Stroke="DarkGray"
                            StrokeThickness="1" />
                        <Ellipse
                            x:Name="innerEllipse"
                            Width="8"
                            Height="8"
                            Fill="Blue"
                            Visibility="Collapsed" />
                    </Grid>

                    <!--  内容  -->
                    <ContentPresenter
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!--  视觉状态管理  -->
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="innerEllipse" Property="Visibility" Value="Visible" />
                    <Setter TargetName="outerEllipse" Property="Stroke" Value="Blue" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="#FFE8E8E8" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="border" Property="Background" Value="#FFDDDDDD" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="border" Property="Opacity" Value="0.5" />
                    <Setter TargetName="outerEllipse" Property="Stroke" Value="#FFAAAAAA" />
                    <Setter TargetName="innerEllipse" Property="Fill" Value="#FFAAAAAA" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!--  图像按钮模板  -->
        <ControlTemplate x:Key="ImageRadioButtonTemplate" TargetType="RadioButton">
            <Border
                x:Name="border"
                BorderBrush="Transparent"
                BorderThickness="2"
                CornerRadius="4">
                <Grid>
                    <Rectangle
                        Width="32"
                        Height="32"
                        Fill="DodgerBlue" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="图" />
                    <Border
                        x:Name="selectionIndicator"
                        Background="#3000BFFF"
                        CornerRadius="4"
                        Opacity="0" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="#FF00BFFF" />
                    <Setter TargetName="selectionIndicator" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="selectionIndicator" Property="Opacity" Value="0.5" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!--  选项卡式按钮样式  -->
        <Style x:Key="TabRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="border"
                            Padding="15,10"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF0078D7" />
                                <Setter TargetName="border" Property="Background" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFEEEEEE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock
                Margin="0,0,0,20"
                FontSize="24"
                FontWeight="Bold"
                Text="RadioButton 样式与模板" />

            <Border
                Margin="0,0,0,20"
                Padding="20"
                Background="#F9F9F9"
                BorderBrush="#DDDDDD"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="基本样式设置" />
                    <TextBlock
                        Margin="0,0,0,10"
                        Text="通过Style修改RadioButton的外观:"
                        TextWrapping="Wrap" />

                    <StackPanel Margin="20,10">
                        <RadioButton Margin="5" Content="默认RadioButton" />
                        <RadioButton
                            Margin="5"
                            Content="自定义样式RadioButton"
                            Style="{StaticResource CustomRadioButtonStyle}" />
                        <TextBlock
                            Margin="5,10"
                            Text="说明: 将鼠标悬停在上面的自定义RadioButton上，颜色会变成绿色；选中后文本会变成红色。"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,20,0,5"
                        FontWeight="Bold"
                        Text="样式代码:" />
                    <Border
                        Margin="0,0,0,10"
                        Padding="10"
                        Background="#333333">
                        <TextBlock
                            FontFamily="Consolas"
                            Foreground="White"
                            TextWrapping="Wrap">
                            <![CDATA[<Style x:Key="CustomRadioButtonStyle" TargetType="RadioButton">
    <Setter Property="Foreground" Value="Navy"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Padding" Value="5"/>
    <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
            <Setter Property="Foreground" Value="Red"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Foreground" Value="Green"/>
        </Trigger>
    </Style.Triggers>
</Style>]]>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,20"
                Padding="20"
                Background="#F9F9F9"
                BorderBrush="#DDDDDD"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="自定义模板" />
                    <TextBlock
                        Margin="0,0,0,10"
                        Text="通过ControlTemplate完全自定义RadioButton的外观:"
                        TextWrapping="Wrap" />

                    <StackPanel Margin="20,10">
                        <RadioButton
                            Margin="5"
                            Content="自定义模板"
                            Template="{StaticResource CustomRadioButtonTemplate}" />
                        <RadioButton
                            Margin="5"
                            Content="自定义模板 (已选中)"
                            IsChecked="True"
                            Template="{StaticResource CustomRadioButtonTemplate}" />
                        <TextBlock
                            Margin="5,10"
                            Text="说明: 这些RadioButton使用了自定义的ControlTemplate，完全改变了控件的外观，但保留了其功能性。"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,20,0,5"
                        FontWeight="Bold"
                        Text="模板代码精简版:" />
                    <Border
                        Margin="0,0,0,10"
                        Padding="10"
                        Background="#333333">
                        <TextBlock
                            FontFamily="Consolas"
                            Foreground="White"
                            TextWrapping="Wrap">
                            <![CDATA[<ControlTemplate x:Key="CustomRadioButtonTemplate" TargetType="RadioButton">
    <Border x:Name="border" BorderBrush="Gray" BorderThickness="1" CornerRadius="8"
            Background="LightGray" Padding="5">
        <Grid>
            <!-- 自定义单选按钮外观 -->
            <Grid Width="16" Height="16">
                <Ellipse x:Name="outerEllipse" Fill="White" Stroke="DarkGray"/>
                <Ellipse x:Name="innerEllipse" Width="8" Height="8" 
                         Fill="Blue" Visibility="Collapsed"/>
            </Grid>
            <!-- 内容 -->
            <ContentPresenter ... />
        </Grid>
    </Border>
    <!-- 触发器 -->
    <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="innerEllipse" Property="Visibility" Value="Visible"/>
        </Trigger>
        <!-- 其他触发器 -->
    </ControlTemplate.Triggers>
</ControlTemplate>]]>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,20"
                Padding="20"
                Background="#F9F9F9"
                BorderBrush="#DDDDDD"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="特殊样式示例" />
                    <TextBlock
                        Margin="0,0,0,10"
                        Text="创建不同风格的RadioButton:"
                        TextWrapping="Wrap" />

                    <StackPanel Margin="20,10" Orientation="Horizontal">
                        <GroupBox Padding="10" Header="图像按钮">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton
                                    Margin="5"
                                    GroupName="Images"
                                    Template="{StaticResource ImageRadioButtonTemplate}" />
                                <RadioButton
                                    Margin="5"
                                    GroupName="Images"
                                    Template="{StaticResource ImageRadioButtonTemplate}" />
                                <RadioButton
                                    Margin="5"
                                    GroupName="Images"
                                    Template="{StaticResource ImageRadioButtonTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox
                            Margin="20,0,0,0"
                            Padding="10"
                            Header="选项卡样式">
                            <StackPanel Background="#F0F0F0" Orientation="Horizontal">
                                <RadioButton
                                    Content="选项卡1"
                                    IsChecked="True"
                                    Style="{StaticResource TabRadioButtonStyle}" />
                                <RadioButton Content="选项卡2" Style="{StaticResource TabRadioButtonStyle}" />
                                <RadioButton Content="选项卡3" Style="{StaticResource TabRadioButtonStyle}" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page> 