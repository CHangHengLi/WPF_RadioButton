<Page
    x:Class="RadioButtonDemo.Pages.BasicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:RadioButtonDemo.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="基本用法"
    d:DesignHeight="1200"
    d:DesignWidth="800"
    Background="AntiqueWhite"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock
                Margin="0,0,0,20"
                FontSize="24"
                FontWeight="Bold"
                Text="RadioButton 基本用法" />

            <Border
                Margin="0,0,0,20"
                Padding="20"
                Background="#F9F9F9"
                BorderBrush="#DDDDDD"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="创建基本的RadioButton" />
                    <TextBlock Margin="0,0,0,10" Text="以下展示了最基本的RadioButton用法:" />

                    <StackPanel Margin="20,10">
                        <RadioButton Margin="5" Content="选项1" />
                        <RadioButton Margin="5" Content="选项2" />
                        <RadioButton Margin="5" Content="选项3" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,20,0,5"
                        FontWeight="Bold"
                        Text="XAML代码:" />
                    <Border
                        Margin="0,0,0,10"
                        Padding="10"
                        Background="#333333">
                        <TextBlock
                            FontFamily="Consolas"
                            Foreground="White"
                            TextWrapping="Wrap">
                            <![CDATA[<RadioButton Content="选项1" Margin="5"/>
<RadioButton Content="选项2" Margin="5"/>
<RadioButton Content="选项3" Margin="5"/>]]>
                        </TextBlock>
                    </Border>

                    <TextBlock
                        Margin="0,10,0,5"
                        FontWeight="Bold"
                        Text="C# 代码:" />
                    <Border
                        Margin="0,0,0,10"
                        Padding="10"
                        Background="#333333">
                        <TextBlock
                            FontFamily="Consolas"
                            Foreground="White"
                            TextWrapping="Wrap">
                            <![CDATA[// 创建RadioButton控件
RadioButton radioButton = new RadioButton();
radioButton.Content = "选项1";
radioButton.Margin = new Thickness(5);]]>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,20"
                Padding="20"
                Background="#F9F9F9"
                BorderBrush="#DDDDDD"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="设置默认选中状态" />
                    <TextBlock Margin="0,0,0,10" Text="通过IsChecked属性设置RadioButton的默认选中状态:" />

                    <StackPanel Margin="20,10">
                        <RadioButton
                            Margin="5"
                            Content="选项1 (默认选中)"
                            IsChecked="True" />
                        <RadioButton Margin="5" Content="选项2" />
                        <RadioButton Margin="5" Content="选项3" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,20,0,5"
                        FontWeight="Bold"
                        Text="XAML代码:" />
                    <Border
                        Margin="0,0,0,10"
                        Padding="10"
                        Background="#333333">
                        <TextBlock
                            FontFamily="Consolas"
                            Foreground="White"
                            TextWrapping="Wrap">
                            <![CDATA[<RadioButton Content="选项1 (默认选中)" IsChecked="True" Margin="5"/>
<RadioButton Content="选项2" Margin="5"/>
<RadioButton Content="选项3" Margin="5"/>]]>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,20"
                Padding="20"
                Background="#F9F9F9"
                BorderBrush="#DDDDDD"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="事件监听" />
                    <TextBlock Margin="0,0,0,10" Text="RadioButton提供了几个事件用于监听状态变化:" />

                    <StackPanel Margin="20,10">
                        <RadioButton
                            x:Name="rbWithEvent"
                            Margin="5"
                            Checked="RadioButton_Checked"
                            Content="点击查看事件" />
                        <TextBlock x:Name="eventResult" Margin="5,10" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,20,0,5"
                        FontWeight="Bold"
                        Text="XAML代码:" />
                    <Border
                        Margin="0,0,0,10"
                        Padding="10"
                        Background="#333333">
                        <TextBlock
                            FontFamily="Consolas"
                            Foreground="White"
                            TextWrapping="Wrap">
                            <![CDATA[<RadioButton x:Name="rbWithEvent" Content="点击查看事件" 
           Margin="5" Checked="RadioButton_Checked"/>
<TextBlock x:Name="eventResult" Margin="5,10"/>]]>
                        </TextBlock>
                    </Border>

                    <TextBlock
                        Margin="0,10,0,5"
                        FontWeight="Bold"
                        Text="C# 代码:" />
                    <Border
                        Margin="0,0,0,10"
                        Padding="10"
                        Background="#333333">
                        <TextBlock
                            FontFamily="Consolas"
                            Foreground="White"
                            TextWrapping="Wrap">
                            <![CDATA[private void RadioButton_Checked(object sender, RoutedEventArgs e)
{
    eventResult.Text = "RadioButton已被选中!";
}]]>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page> 