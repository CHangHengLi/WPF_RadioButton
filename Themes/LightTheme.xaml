<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- 浅色主题资源 -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#333333"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D7"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#DDDDDD"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#007ACC"/>
    <SolidColorBrush x:Key="HeaderForegroundBrush" Color="White"/>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="White"/>
    
    <!-- 控件样式 -->
    <Style TargetType="Page">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
    </Style>
    
    <Style TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    </Style>
    
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
    </Style>
    
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
    </Style>
    
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="Background" Value="White"/>
    </Style>
    
</ResourceDictionary> 